# =============================================================================
# .env.example — `cp .env.example .env` 후 값만 채우세요. `.env`는 커밋 금지.
# =============================================================================

# ── Jira (Atlassian Cloud) ──────────────────────────────────────────────────
JIRA_BASE_URL=https://doverunner.atlassian.net
JIRA_EMAIL=you@doverunner.com
JIRA_TOKEN=발급받은_ATLASSIAN_API_토큰
JIRA_PROJECTS=AS,AR
JIRA_TEAM_FIELD=                # 팀 정보 커스텀 필드 ID. 없으면 비움(component 사용)

# ── Bitbucket Cloud ─────────────────────────────────────────────────────────
BITBUCKET_EMAIL=you@doverunner.com
# BITBUCKET_USERNAME=          # App password 사용 시에만
BITBUCKET_TOKEN=발급받은_ATLASSIAN_API_토큰_또는_App_password

# 저장소 자동 탐색 (매 실행마다 해당 프로젝트의 활성 저장소 포함)
BITBUCKET_WORKSPACE=appsealing
BITBUCKET_PROJECTS=AS,AR
BITBUCKET_ACTIVE_DAYS=90
BITBUCKET_BRANCH=develop        # 없으면 기본 브랜치로 자동 폴백
# BITBUCKET_BRANCH_FALLBACK=1
# (선택) 수동으로 더할 저장소. workspace/slug 콤마 구분
BITBUCKET_REPOS=

# ── 경로 / 알림 ──────────────────────────────────────────────────────────────
# 중요: 반드시 "절대경로"로 지정하세요. 상대경로면 cron/다른 위치 실행 시 실패합니다.
DB_PATH=/Users/<사용자>/Desktop/Automation/ai_productivity/data.sqlite
SLACK_WEBHOOK=                  # 선택: ETL 실패 알림용 Slack webhook
